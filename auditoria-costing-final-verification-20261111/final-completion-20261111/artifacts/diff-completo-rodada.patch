[32m+[m[32m-- Costing tenant isolation and least-privilege grants.[m
[32m+[m[32m-- This is intentionally incremental: historical migrations are not rewritten.[m
[32m+[m
[32m+[m[32mCREATE SCHEMA IF NOT EXISTS private;[m
[32m+[m[32mREVOKE ALL ON SCHEMA private FROM PUBLIC;[m
[32m+[m
[32m+[m[32m-- A bootstrap-safe fallback is created only when the canonical helper has not[m
[32m+[m[32m-- been installed yet by rls_multitenant.sql. The canonical helper later[m
[32m+[m[32m-- replaces this body with Supabase auth.uid() support.[m
[32m+[m[32mDO $$[m
[32m+[m[32mBEGIN[m
[32m+[m[32m  IF to_regprocedure('private.current_app_user_id()') IS NULL THEN[m
[32m+[m[32m    EXECUTE $fn$[m
[32m+[m[32m      CREATE FUNCTION private.current_app_user_id()[m
[32m+[m[32m      RETURNS integer[m
[32m+[m[32m      LANGUAGE sql[m
[32m+[m[32m      STABLE[m
[32m+[m[32m      SECURITY DEFINER[m
[32m+[m[32m      SET search_path = public[m
[32m+[m[32m      AS $body$[m
[32m+[m[32m        SELECT id[m
[32m+[m[32m        FROM public.users[m
[32m+[m[32m        WHERE id = NULLIF(current_setting('request.app_user_id', true), '')::integer[m
[32m+[m[32m        LIMIT 1[m
[32m+[m[32m      $body$[m
[32m+[m[32m    $fn$;[m
[32m+[m[32m  END IF;[m
[32m+[m
[32m+[m[32m  IF to_regprocedure('private.has_organization_access(character varying)') IS NULL THEN[m
[32m+[m[32m    EXECUTE $fn$[m
[32m+[m[32m      CREATE FUNCTION private.has_organization_access(target_organization_id varchar)[m
[32m+[m[32m      RETURNS boolean[m
[32m+[m[32m      LANGUAGE sql[m
[32m+[m[32m      STABLE[m
[32m+[m[32m      SECURITY DEFINER[m
[32m+[m[32m      SET search_path = public[m
[32m+[m[32m      AS $body$[m
[32m+[m[32m        SELECT EXISTS ([m
[32m+[m[32m          SELECT 1[m
[32m+[m[32m          FROM public.organization_members membership[m
[32m+[m[32m          WHERE membership."organizationId" = target_organization_id[m
[32m+[m[32m            AND membership."userId" = private.current_app_user_id()[m
[32m+[m[32m            AND membership.status = 'active'[m
